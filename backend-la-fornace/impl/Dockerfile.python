# Imagen de un sistema Python. Uso: docker build -f Dockerfile.python --build-arg SERVICIO=orders -t fornace/orders .
# BASE se puede cambiar.
ARG BASE=python:3.13-slim
FROM ${BASE}
ARG SERVICIO
ENV SERVICIO=${SERVICIO} PYTHONUNBUFFERED=1 PYTHONPATH=/app/common
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY common /app/common
COPY services/${SERVICIO} /app/service
RUN echo 'app:x:10001:10001::/nonexistent:/usr/sbin/nologin' >> /etc/passwd && echo 'app:x:10001:' >> /etc/group \
 && mkdir -p /logs && chown 10001:10001 /logs
USER 10001
WORKDIR /app/service
EXPOSE 8000
CMD ["python", "main.py"]

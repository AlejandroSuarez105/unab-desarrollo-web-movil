# Configuracion NO secreta. Copiar a .env (que no se versiona). Los secretos viven solo en Vault.
FRONTEND_URL=http://127.0.0.1:8080
FRONTEND_ORIGIN=http://127.0.0.1:8080
COMUNAS_COBERTURA=Maipú,Cerrillos,Pudahuel,Estación Central
RL_FACTOR=1
PEDIDO_SEGUNDOS=900
TOKEN_SECONDS=900
VAULT_GRACIA_SEGUNDOS=900
# Docker Compose: el token raiz de Vault de desarrollo se define aqui al copiar el archivo (no se escribe en el repositorio)
VAULT_DEV_ROOT_TOKEN=
# Docker Compose: clave del usuario root de MongoDB (solo la usan preparacion y las herramientas); se genera al azar con compose.py preparar
MONGO_ROOT_PASSWORD=
# Opcional: cambiar las imagenes (por omision se usan las que indica docker-compose.yml)
# PY_BASE=python:3.13-slim
# NODE_BASE=node:22-slim
# MONGO_IMAGE=mongo:7
# VAULT_IMAGE=hashicorp/vault:1.18

# Servidor estatico del frontend (solo desarrollo; sin logica de negocio).
ARG BASE=python:3.13-slim
FROM ${BASE}
WORKDIR /app
COPY frontend /app/frontend
COPY scripts/serve_frontend.py /app/serve_frontend.py
RUN echo 'app:x:10001:10001::/nonexistent:/usr/sbin/nologin' >> /etc/passwd && echo 'app:x:10001:' >> /etc/group
USER 10001
ENV HOST=0.0.0.0 PORT=8080 RAIZ_FRONTEND=/app/frontend
EXPOSE 8080
CMD ["python", "serve_frontend.py"]

# Imagen del GraphQL Gateway (Node). BASE se puede cambiar igual que en Dockerfile.python.
ARG BASE=node:22-slim
FROM ${BASE}
WORKDIR /app
COPY services/graphql_gateway/ ./
RUN if [ ! -d node_modules ]; then npm ci --omit=dev; fi
RUN echo 'app:x:10001:10001::/nonexistent:/usr/sbin/nologin' >> /etc/passwd && echo 'app:x:10001:' >> /etc/group \
 && mkdir -p /logs && chown 10001:10001 /logs
USER 10001
EXPOSE 8000
CMD ["node", "server.js"]
